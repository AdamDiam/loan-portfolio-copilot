# Copy this file to .env and fill in your key. Never commit .env.
OPENAI_API_KEY=sk-...

# Any chat model your key can access (check with: python scripts/check_openai.py)
OPENAI_MODEL=gpt-5.4-mini

# Embedding model for the regulatory document search
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Optional settings
# COPILOT_DB_PATH=data/portfolio.db
# COPILOT_MAX_ROWS=1000
# COPILOT_QUERY_TIMEOUT_S=15
# COPILOT_MAX_RETRIES=2
# COPILOT_DOCS_DB_PATH=data/docs.db
